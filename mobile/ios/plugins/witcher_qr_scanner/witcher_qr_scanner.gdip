[config]
name="WitcherQrScanner"
binary="witcher_qr_scanner.xcframework"

initialization="register_witcher_qr_scanner_types"
deinitialization="unregister_witcher_qr_scanner_types"

[dependencies]
linked=[]
embedded=[]
system=["AVFoundation.framework", "UIKit.framework"]

capabilities=[]

files=[]

[plist]
NSCameraUsageDescription="Scans Witcher LARP QR order signs offline on this iPhone."
