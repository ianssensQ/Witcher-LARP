; Engine configuration file.
; Edit this file through the Godot editor when possible.
config_version=5

[application]
config/name="Witcher LARP Mobile"
config/description="Offline-first mobile shell for the one-day Witcher LARP."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.x", "Mobile")
config/icon="res://icon.svg"

[autoload]
AppState="*res://scripts/app_state.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
